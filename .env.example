# Copy to .env (or just export these in your shell) before running the AI tabs.

# Your Anthropic API key. The dashboard reads it automatically.
# If you logged in with `ant auth login` instead, you can leave this unset.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model the AI layer uses.
# Default is claude-opus-4-8. Switch to claude-haiku-4-5 to cut demo cost.
# ASCENDIT_DEMO_MODEL=claude-haiku-4-5
